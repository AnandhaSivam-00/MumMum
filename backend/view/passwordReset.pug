doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Password Reset - MumMum
    style.
      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        background-color: #fefae0;
        color: #2d261e;
        margin: 0;
        padding: 20px;
        text-align: center;
      }
      .container {
        max-width: 600px;
        margin: 0 auto;
        background-color: #faedcd;
        border-radius: 12px;
        padding: 40px;
        border: 1px solid rgba(212, 163, 115, 0.3);
      }
      .header {
        margin-bottom: 30px;
      }
      .logo {
        max-width: 80px;
        margin-bottom: 15px;
      }
      .title {
        font-size: 22px;
        font-weight: 700;
        color: #2d261e;
        margin-bottom: 20px;
      }
      .content {
        font-size: 15px;
        line-height: 1.7;
        color: #736b60;
        margin-bottom: 30px;
        text-align: left;
      }
      .content p {
        margin-bottom: 15px;
      }
      .button-wrap {
        text-align: center;
        margin: 28px 0;
      }
      a.button {
        color: #fefae0 !important;
        background-color: #d4a373;
        border-radius: 8px;
        font-size: 15px;
        font-weight: 600;
        text-decoration: none;
        padding: 14px 32px;
        display: inline-block;
      }
      .url-fallback {
        font-size: 12px;
        color: #a0998f;
        word-break: break-all;
        margin-top: 16px;
      }
      .footer {
        margin-top: 30px;
        font-size: 11px;
        color: #a0998f;
        border-top: 1px solid rgba(212, 163, 115, 0.3);
        padding-top: 20px;
        line-height: 1.6;
      }
  body
    .container
      .header
        img.logo(src="https://res.cloudinary.com/anandsivam-00/image/upload/v1785576055/avatars/brand-logo_wrakbu.png", alt="Brand Logo")
        .title Password Reset Request
      .content
        p Dear #{firstName},
        p We received a request to reset the password for your MumMum account. Click the button below to choose a new password:
        .button-wrap
          a.button(href=url) Reset My Password
        p If you are having trouble clicking the button, copy and paste the URL below into your web browser:
        p.url-fallback #{url}
        p This link is valid for 10 minutes. If you did not request a password reset, please ignore this email - your account remains secure.
      .footer
        p &copy; MumMum
        p You are receiving this email because a password reset was requested for your account.