doctype html
html
  head
    title Password Reset
    style.
      body {
        font-family: "Amazon Ember", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        background-color: #fefae0;
        color: #2d261e;
        margin: 0;
        padding: 20px;
        text-align: center;
      }
      .container {
        max-width: 600px;
        margin: 0 auto;
        background-color: #faedcd;
        border-radius: 12px;
        padding: 40px;
        box-shadow: 0 4px 18px -2px rgba(45, 38, 30, 0.08);
        border: 1px solid rgba(212, 163, 115, 0.3);
      }
      .header {
        margin-bottom: 30px;
      }
      .logo {
        max-width: 80px;
        margin-bottom: 15px;
      }
      .title {
        font-size: 24px;
        font-weight: 700;
        color: #2d261e;
        margin-bottom: 20px;
      }
      .content {
        font-size: 16px;
        line-height: 1.5;
        color: #736b60;
        margin-bottom: 30px;
        text-align: left;
      }
      .content p {
        margin-bottom: 15px;
      }
      a.button {
        color: #fefae0;
        width: 100%;
        max-width: 250px;
        height: 50px;
        background-color: #d4a373;
        border-radius: 8px;
        border: none;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: background-color 0.2s ease;
        margin: 20px auto;
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
      }
      a.button:hover {
        background-color: #b88352;
      }
      .footer {
        margin-top: 30px;
        font-size: 12px;
        color: #736b60;
        border-top: 1px solid rgba(212, 163, 115, 0.3);
        padding-top: 20px;
      }
  body
    .container
      .header
        img.logo(src="https://via.placeholder.com/80x80.png?text=Logo", alt="Brand Logo")
        .title Password Reset Request
      .content
        p Hi #{firstName},
        p We received a request to reset your password. To set a new password, please click the button below:
        a.button(href=`${url}`, target='_blank') RESET YOUR PASSWORD
        p If you didn't request a password reset, you can safely ignore this email. Your account is secure.
      .footer
        p This is an automated message, please do not reply to this email.
