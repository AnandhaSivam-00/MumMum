doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Welcome to MumMum!
    style.
      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        background-color: #fefae0;
        color: #2d261e;
        margin: 0;
        padding: 20px;
        text-align: center;
      }
      .container {
        max-width: 600px;
        margin: 0 auto;
        background-color: #faedcd;
        border-radius: 12px;
        padding: 40px;
        border: 1px solid rgba(212, 163, 115, 0.3);
      }
      .header {
        margin-bottom: 30px;
      }
      .logo {
        max-width: 80px;
        margin-bottom: 15px;
      }
      .title {
        font-size: 22px;
        font-weight: 700;
        color: #2d261e;
        margin-bottom: 20px;
      }
      .content {
        font-size: 15px;
        line-height: 1.7;
        color: #736b60;
        margin-bottom: 30px;
        text-align: left;
      }
      .content p {
        margin-bottom: 15px;
      }
      .button-wrap {
        text-align: center;
        margin: 28px 0;
      }
      a.button {
        color: #fefae0 !important;
        background-color: #d4a373;
        border-radius: 8px;
        font-size: 15px;
        font-weight: 600;
        text-decoration: none;
        padding: 14px 32px;
        display: inline-block;
      }
      .footer {
        margin-top: 30px;
        font-size: 11px;
        color: #a0998f;
        border-top: 1px solid rgba(212, 163, 115, 0.3);
        padding-top: 20px;
        line-height: 1.6;
      }
  body
    .container
      .header
        img.logo(src="https://res.cloudinary.com/anandsivam-00/image/upload/v1785576055/avatars/brand-logo_wrakbu.png", alt="Brand Logo")
        .title Welcome to MumMum!
      .content
        p Dear #{firstName},
        p Welcome to MumMum! We're so glad you joined us.
        p Get started by exploring our delicious menu and placing your first order.
        .button-wrap
          a.button(href=url, target="_blank") EXPLORE MENU
        p If you need any help, don't hesitate to contact our support team.
        p Enjoy!
      .footer
        p &copy; MumMum
        p You are receiving this email because you created an account on MumMum.
