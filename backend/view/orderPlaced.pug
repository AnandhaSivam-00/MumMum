doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Order Confirmed - MumMum
    style.
      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        background-color: #fefae0;
        color: #2d261e;
        margin: 0;
        padding: 20px;
        text-align: center;
      }
      .container {
        max-width: 600px;
        margin: 0 auto;
        background-color: #faedcd;
        border-radius: 12px;
        padding: 40px;
        border: 1px solid rgba(212, 163, 115, 0.3);
      }
      .header {
        margin-bottom: 30px;
      }
      .logo {
        max-width: 80px;
        margin-bottom: 15px;
      }
      .title {
        font-size: 22px;
        font-weight: 700;
        color: #2d261e;
        margin-bottom: 20px;
      }
      .content {
        font-size: 15px;
        line-height: 1.7;
        color: #736b60;
        margin-bottom: 30px;
        text-align: left;
      }
      .content p {
        margin-bottom: 15px;
      }
      .details {
        background-color: #fefae0;
        padding: 20px;
        border-radius: 10px;
        margin: 20px 0;
        border: 1px solid rgba(212, 163, 115, 0.3);
      }
      .details-header {
        font-size: 16px;
        font-weight: 700;
        color: #2d261e;
        margin-bottom: 12px;
        border-bottom: 1px solid rgba(212, 163, 115, 0.3);
        padding-bottom: 8px;
      }
      .order-meta {
        font-size: 13px;
        color: #736b60;
        margin-bottom: 15px;
      }
      .item-table {
        width: 100%;
        border-collapse: collapse;
        margin: 15px 0;
      }
      .item-table th, .item-table td {
        padding: 10px 8px;
        text-align: left;
        border-bottom: 1px solid rgba(212, 163, 115, 0.2);
        font-size: 14px;
      }
      .item-table th {
        color: #2d261e;
        font-weight: 600;
      }
      .total-price {
        text-align: right;
        font-size: 16px;
        font-weight: 700;
        color: #2d261e;
        margin-top: 15px;
        padding-top: 10px;
      }
      .address-section {
        margin-top: 20px;
        padding-top: 15px;
        border-top: 1px dashed rgba(212, 163, 115, 0.4);
      }
      .button-wrap {
        text-align: center;
        margin: 28px 0;
      }
      a.button {
        color: #fefae0 !important;
        background-color: #d4a373;
        border-radius: 8px;
        font-size: 15px;
        font-weight: 600;
        text-decoration: none;
        padding: 14px 32px;
        display: inline-block;
      }
      .footer {
        margin-top: 30px;
        font-size: 11px;
        color: #a0998f;
        border-top: 1px solid rgba(212, 163, 115, 0.3);
        padding-top: 20px;
        line-height: 1.6;
      }
  body
    .container
      .header
        img.logo(src="https://res.cloudinary.com/anandsivam-00/image/upload/v1785576055/avatars/brand-logo_wrakbu.png", alt="Brand Logo")
        .title Order Confirmed!
      .content
        p Dear #{firstName},
        p Thank you for your order! Your payment has been confirmed and your order has been placed successfully.
        
        .details
          .details-header Order Details
          .order-meta
            p(style="margin: 4px 0;")
              strong Order ID: 
              | #{order._id}
            p(style="margin: 4px 0;")
              strong Time Placed: 
              | #{new Date(order.createdAt).toLocaleString()}
          
          table.item-table
            thead
              tr
                th Item
                th Qty
                th Price
            tbody
              each item in order.orderItems
                tr
                  td #{item.name}
                  td #{item.quantity}
                  td $#{item.price}
          
          .total-price
            | Total Amount: $#{order.finalTotal}
            
          .address-section
            strong Delivery Address:
            p(style="margin-top: 6px; font-size: 14px; color: #736b60;") #{order.deliveryInfo.address}, #{order.deliveryInfo.city}, #{order.deliveryInfo.phoneNo}, #{order.deliveryInfo.postalCode}, #{order.deliveryInfo.country}

        p We are preparing your delicious food right now. Enjoy!
        
        if url
          .button-wrap
            a.button(href=url, target="_blank") View Order Status
      .footer
        p &copy; MumMum
        p You are receiving this email as confirmation for an order placed on MumMum.
